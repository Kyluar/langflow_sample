{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "format": {
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false
    },
    "@repo/database#build": {
      "dependsOn": ["db:generate"],
      "outputs": ["dist/**"]
    },
    "@repo/database#db:migrate": {
      "inputs": ["prisma/migrations/**" ]
    },
    "@repo/database#db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "@repo/database#db:seed": {
      "cache": false
    },
    "@repo/database#db:migrate:test": {
      "cache": false
    },
    "@repo/database#db:push:test": {
      "cache": false
    },
    "@repo/database#db:seed:test": {
      "cache": false
    }
  }
}
