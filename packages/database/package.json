{
  "name": "@repo/database",
  "version": "1.0.0",
  "description": "Shared db types",
  "private": true,
  "exports": {
    "./generated/prisma/client": {
      "types": "./dist/src/generated/prisma/client.d.ts",
      "default": "./dist/src/generated/prisma/client.js"
    },
    "./lib/utils": {
      "types": "./dist/src/lib/utils.d.ts",
      "default": "./dist/src/lib/utils.js"
    },
    "./generated/prisma/*": {
      "types": "./dist/src/generated/prisma/*.d.ts",
      "default": "./dist/src/generated/prisma/*.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check-types": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^25.0.9",
    "@types/pg": "^8.16.0",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "pg": "^8.17.1"
  }
}
